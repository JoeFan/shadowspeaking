# =========================
# Shadowing Player .gitignore
# =========================

# Node / Vite
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust / Tauri
src-tauri/target/
target/

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-version

# Environment / secrets
.env
.env.*
!.env.example

# Local app data / databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# Media/cache/generated files
cache/
tmp/
temp/
downloads/
processed/
generated/
*.shadowlesson

# Whisper / model caches
models/
.huggingface/
huggingface/
whisper-models/

# Bundled FFmpeg binaries copied locally before build
# Keep documentation, ignore platform binaries.
bin/*
!bin/README.md

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Logs
*.log
logs/

# Tauri / installer outputs
*.dmg
*.msi
*.exe
*.app
*.deb
*.AppImage

# Release archives
*.zip
*.tar
*.tar.gz
*.7z

# Signing / local certificates
*.p12
*.cer
*.mobileprovision
*.provisionprofile

# Test / coverage
coverage/
.coverage
htmlcov/

# Misc temporary files
*.tmp
*.temp
