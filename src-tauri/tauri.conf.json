{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shadowing Player",
  "version": "3.3.0",
  "identifier": "com.lingfan.shadowingplayer.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shadowing Player",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../python/worker.py",
      "../python/requirements.txt"
    ]
  }
}